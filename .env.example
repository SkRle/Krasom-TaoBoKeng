# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้ามใส่ค่าจริงในไฟล์นี้ — ไฟล์นี้ถูก commit)

# ---------- Session (เซ็น cookie เข้าสู่ระบบ) ----------
# สร้างค่าใหม่ด้วย: openssl rand -base64 48
SESSION_SECRET=

# ---------- Database (Supabase Postgres) ----------
# Supabase > Connect > ORMs/Prisma (มีรหัสผ่านฐานข้อมูล)
# Transaction pooler (6543) ใช้ตอนแอปทำงาน
DATABASE_URL="postgresql://postgres.wzwcygizptaeniuxsspw:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session/direct (5432) ใช้กับ Prisma CLI
DIRECT_URL="postgresql://postgres.wzwcygizptaeniuxsspw:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------- Google Drive (OAuth2 ของ krasomtaobokeng@gmail.com) ----------
# ต้องใช้ scope https://www.googleapis.com/auth/drive (ขอด้วย `npm run google:token`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
